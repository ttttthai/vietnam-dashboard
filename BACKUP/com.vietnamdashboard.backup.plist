  <key>StandardOutPath</key><string>/Users/hoangthai/CLAUDECODE/VIETNAM DASHBOARD/BACKUP/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/hoangthai/CLAUDECODE/VIETNAM DASHBOARD/BACKUP/launchd.log</string>
</dict>
</plist>

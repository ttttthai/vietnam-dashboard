\u000a    <LoginName>i:0#.w|vpbtc\\\\vuxuantu<\\\/LoginName>\\u000a    <FullName>Vu Xuan Tu<\\\/FullName>\\u000a    <ThoiGian>2026-05-26T09:12:37.7613986+07:00<\\\/ThoiGian>\\u000a    <Buoc>Ban hành<\\\/Buoc>\\u000a    <GhiChu \\\/>\\u000a  <\\\/CMSHistoryEntity>\\u000a<\\\/ArrayOfCMSHistoryEntity>\",\"ListName\":\"Tin Tức\",\"LoaiBaiViet\":\"Tin\",\"Media\":null,\"Modified\":null,\"PostCategory\":{\"LookupId\":1},\"PostCategoryName\":\"Tin tức - Sự kiện;#2;#Thông báo\",\"PublishedDate\":\"\\\/Date(1779447600000+0700)\\\/\",\"PublishedDateText\":\"22\\\/05\\\/2026\",\"ReadCounter\":1,\"SourceUrl\":null,\"TacGia\":{\"LookupId\":12},\"TacGiaName\":\"hethongthongtinTKTC\",\"TinNoiBat\":null,\"Title\":\"Bộ Tài chính công khai Quyết toán ngân sách nhà nước năm 2024\",\"TopItem\":false,\"TrangThai\":\"Đã ban hành\",\"WebUrl\":null,\"_ModerationStatus\":null}"